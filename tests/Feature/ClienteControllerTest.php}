<?php

namespace Tests\Feature;

use App\Models\User;
use App\Models\Cliente;
use Illuminate\Foundation\Testing\RefreshDatabase;
use Tests\TestCase;

class ClienteControllerTest extends TestCase
{
    use RefreshDatabase;

    /** @test */
    public function recepcionista_puede_ver_lista_de_clientes()
    {
        $user = User::factory()->create(['role' => 'recepcionista']);
        Cliente::factory()->count(3)->create();

        $response = $this->actingAs($user)->get('/clientes');
        $response->assertStatus(200);
        $response->assertViewHas('clientes');
    }

    /** @test */
    public function recepcionista_puede_ver_formulario_de_crear_cliente()
    {
        $user = User::factory()->create(['role' => 'recepcionista']);
        $response = $this->actingAs($user)->get('/clientes/create');
        $response->assertStatus(200);
    }

    /** @test */
    public function recepcionista_puede_registrar_un_cliente()
    {
        $user = User::factory()->create(['role' => 'recepcionista']);

        $response = $this->actingAs($user)->post('/clientes', [
            'nombre_completo' => 'Juan Pérez',
            'telefono' => '78945612',
            'direccion' => 'Av. 6 de Agosto, La Paz',
            'latitud' => -16.5000,
            'longitud' => -68.1500,
        ]);

        $response->assertRedirect('/clientes');
        $this->assertDatabaseHas('clientes', [
            'nombre_completo' => 'Juan Pérez',
            'telefono' => '78945612',
        ]);
    }

    /** @test */
    public function no_puede_registrar_cliente_con_telefono_duplicado()
    {
        $user = User::factory()->create(['role' => 'recepcionista']);
        Cliente::factory()->create(['telefono' => '78945612']);

        $response = $this->actingAs($user)->post('/clientes', [
            'nombre_completo' => 'Otro Cliente',
            'telefono' => '78945612',
            'direccion' => 'Otra Dirección',
        ]);

        $response->assertSessionHasErrors('telefono');
        $this->assertEquals(1, Cliente::count());
    }

    /** @test */
    public function recepcionista_puede_editar_un_cliente()
    {
        $user = User::factory()->create(['role' => 'recepcionista']);
        $cliente = Cliente::factory()->create();

        $response = $this->actingAs($user)->put("/clientes/{$cliente->id}", [
            'nombre_completo' => 'Nombre Editado',
            'telefono' => $cliente->telefono,
            'direccion' => 'Nueva Dirección',
        ]);

        $response->assertRedirect('/clientes');
        $this->assertDatabaseHas('clientes', [
            'id' => $cliente->id,
            'nombre_completo' => 'Nombre Editado',
        ]);
    }

    /** @test */
    public function recepcionista_puede_eliminar_un_cliente()
    {
        $user = User::factory()->create(['role' => 'recepcionista']);
        $cliente = Cliente::factory()->create();

        $response = $this->actingAs($user)->delete("/clientes/{$cliente->id}");

        $response->assertRedirect('/clientes');
        $this->assertDatabaseMissing('clientes', ['id' => $cliente->id]);
    }

    /** @test */
    public function recepcionista_puede_bloquear_un_cliente()
    {
        $user = User::factory()->create(['role' => 'recepcionista']);
        $cliente = Cliente::factory()->create(['bloqueado' => false]);

        $response = $this->actingAs($user)->post("/clientes/{$cliente->id}/toggle-bloqueo");

        $response->assertRedirect();
        $this->assertTrue($cliente->fresh()->bloqueado);
    }

    /** @test */
    public function usuario_no_autenticado_no_puede_ver_clientes()
    {
        $response = $this->get('/clientes');
        $response->assertRedirect('/login');
    }
}